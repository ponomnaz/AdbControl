<UserControl x:Class="AdbControl.Tools.CommandLog.Views.CommandLogToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:AdbControl.Tools.CommandLog.Behaviors"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="CommandLogListBoxStyle" TargetType="ListBox" BasedOn="{StaticResource WorkbenchListBoxStyle}">
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>

        <Style x:Key="CommandLogEntryListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Card}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSelection}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource PanelSurfaceStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.PageTitleStyle}" Text="Журнал" />
                    <StackPanel Margin="0,8,0,0"
                                Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource Text.CaptionStyle}"
                                   Text="{Binding TotalSummary}" />
                        <TextBlock Margin="12,0,0,0"
                                   Style="{DynamicResource Text.CaptionStyle}"
                                   Foreground="{DynamicResource Brush.DangerPrimary}"
                                   Text="{Binding ErrorSummary}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <ComboBox Width="180"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              Style="{DynamicResource CompactComboBoxInputStyle}"
                              ItemsSource="{Binding DeviceFilters}"
                              SelectedItem="{Binding SelectedDeviceFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="DisplayText" />
                    <Button Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Command="{Binding DeleteSelectedCommand}"
                            Content="Удалить выбранную"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button Command="{Binding ClearAllCommand}"
                            VerticalAlignment="Center"
                            Content="Очистить всё"
                            Style="{DynamicResource DangerButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{DynamicResource PanelSurfaceStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{DynamicResource Text.SectionTitleStyle}"
                               Text="Команды" />

                    <ListBox Grid.Row="1"
                             Margin="0,8,0,0"
                             ItemsSource="{Binding VisibleEntries}"
                             SelectionMode="Single"
                             behaviors:ListBoxSelectionBehavior.SelectedItems="{Binding SelectedEntries}"
                             Style="{StaticResource CommandLogListBoxStyle}"
                             ItemContainerStyle="{StaticResource CommandLogEntryListBoxItemStyle}">
                        <ListBox.InputBindings>
                            <KeyBinding Key="Delete"
                                        Command="{Binding DeleteSelectedCommand}" />
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{DynamicResource Text.CaptionStyle}"
                                               TextWrapping="NoWrap"
                                               Text="{Binding Timestamp, StringFormat='{}{0:dd.MM HH:mm:ss}'}" />
                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding CommandText}" />
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Padding="8,2"
                                            CornerRadius="8"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource Brush.DangerSoft}"
                                            BorderBrush="{DynamicResource Brush.DangerBorder}"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Foreground="{DynamicResource Brush.DangerPrimary}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="Ошибка" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{DynamicResource PanelSurfaceStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.SectionTitleStyle}"
                                   Text="Детали" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{DynamicResource Text.CaptionStyle}"
                                   Text="{Binding SelectedTimestamp}" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{DynamicResource Text.CaptionStyle}"
                                   Text="{Binding SelectedExitCode}" />
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Margin="0,12,0,0"
                             IsReadOnly="True"
                             Style="{DynamicResource TextBoxInputStyle}"
                             Text="{Binding SelectedCommandText, Mode=OneWay}" />

                    <Grid Grid.Row="2"
                          Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{DynamicResource Text.CaptionStyle}"
                                   Text="stdout" />
                        <TextBox Grid.Row="1"
                                 Margin="0,8,0,0"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{DynamicResource TextBoxInputStyle}"
                                 Text="{Binding SelectedStdout, Mode=OneWay}" />
                    </Grid>

                    <Grid Grid.Row="3"
                          Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{DynamicResource Text.CaptionStyle}"
                                   Text="stderr" />
                        <TextBox Grid.Row="1"
                                 Margin="0,8,0,0"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{DynamicResource TextBoxInputStyle}"
                                 Text="{Binding SelectedStderr, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
