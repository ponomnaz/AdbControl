<UserControl x:Class="AdbControl.Tools.Apk.Views.ApkLibraryToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:AdbControl.Shell.Behaviors;assembly=AdbControl.Shell"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="DropZoneStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.BackgroundSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDropActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSelection}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentPrimary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SortToggleButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.AccentPrimary}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SortDirectionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApkModeTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Padding="10,6">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSelection}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RightPanelDraftSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfacePrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
            <Setter Property="Padding" Value="{DynamicResource Padding.PanelDense}" />
        </Style>

        <Style x:Key="InstallResultListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.Card}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSelection}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PackagePresenceBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.AccentSelection}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="19*" />
                <ColumnDefinition Width="21*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,3,0"
                    Style="{DynamicResource PanelSurfaceStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{DynamicResource Text.SectionTitleStyle}"
                                   Text="Мои APK" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Margin="0,0,8,0"
                                    Command="{Binding InstallSelectedCommand}"
                                    Content="Установить"
                                    Style="{DynamicResource PrimaryButtonStyle}" />
                            <Button Command="{Binding DeleteSelectedCommand}"
                                    Content="Удалить выбранные"
                                    Style="{DynamicResource DangerButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Margin="0,12,0,0"
                                Orientation="Horizontal">
                        <RadioButton Content="Название"
                                     GroupName="ApkSortField"
                                     IsChecked="{Binding IsSortByName}"
                                     Style="{StaticResource SortToggleButtonStyle}" />
                        <RadioButton Margin="8,0,0,0"
                                     Content="Дата"
                                     GroupName="ApkSortField"
                                     IsChecked="{Binding IsSortByDate}"
                                     Style="{StaticResource SortToggleButtonStyle}" />
                        <RadioButton Margin="8,0,0,0"
                                     Content="Размер"
                                     GroupName="ApkSortField"
                                     IsChecked="{Binding IsSortBySize}"
                                     Style="{StaticResource SortToggleButtonStyle}" />
                        <Button Margin="12,0,0,0"
                                Command="{Binding ToggleSortDirectionCommand}"
                                Content="{Binding SortDirectionGlyph}"
                                Style="{StaticResource SortDirectionButtonStyle}" />
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Margin="0,8,0,0"
                               Style="{DynamicResource Text.BodyMutedStyle}"
                               Text="{Binding StatusText}"
                               Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Grid Grid.Row="3"
                          Margin="0,12,0,0">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding EmptyStateMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.BodyMutedStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEntries}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListBox ItemsSource="{Binding Entries}"
                                 SelectionMode="Extended"
                                 behaviors:ListSelectionBehavior.SelectedItems="{Binding SelectedEntries}"
                                 ItemContainerStyle="{DynamicResource WorkbenchListBoxItemStyle}">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource WorkbenchListBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEntries}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.InputBindings>
                                <KeyBinding Key="Delete"
                                            Command="{Binding DeleteSelectedCommand}" />
                            </ListBox.InputBindings>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding DisplayName}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{DynamicResource Text.CaptionStyle}"
                                                   Text="{Binding MetaText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Row="4"
                            Margin="0,8,0,0"
                            AllowDrop="True"
                            DragEnter="OnDropZoneDragEnter"
                            DragLeave="OnDropZoneDragLeave"
                            DragOver="OnDropZoneDragOver"
                            Drop="OnDropZoneDrop"
                            MouseLeftButtonUp="OnDropZoneClick"
                            Style="{StaticResource DropZoneStyle}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis">
                            <Run FontWeight="SemiBold"
                                 Text="Добавить APK" />
                            <Run Text="  " />
                            <Run Foreground="{DynamicResource Brush.TextSecondary}"
                                 Text="перетащи или нажми" />
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="3,0,0,0"
                    Style="{DynamicResource PanelSurfaceStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{DynamicResource Text.SectionTitleStyle}"
                               Text="На телевизорах" />

                    <Border Grid.Row="1"
                            Margin="0,8,0,0"
                            Height="120"
                            Style="{StaticResource RightPanelDraftSurfaceStyle}">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{Binding EmptyTargetsMessage}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.BodyMutedStyle}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasConnectedDevices}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ListBox Height="84"
                                     ItemsSource="{Binding ConnectedDevices}"
                                     SelectionMode="Extended"
                                     behaviors:ListSelectionBehavior.SelectedItems="{Binding SelectedTargetDevices}"
                                     ItemContainerStyle="{DynamicResource WorkbenchListBoxItemStyle}">
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource WorkbenchListBoxStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasConnectedDevices}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,6,0,0"
                            Style="{StaticResource RightPanelDraftSurfaceStyle}">
                        <TabControl>
                            <TabControl.Resources>
                                <Style TargetType="TabItem" BasedOn="{StaticResource ApkModeTabItemStyle}" />
                            </TabControl.Resources>
                            <TabItem Header="Установить">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Style="{DynamicResource Text.CaptionStyle}"
                                               Text="{Binding InstallSelectionSummary}"
                                               Visibility="{Binding HasInstallSelectionSummary, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{DynamicResource Text.CaptionStyle}"
                                               Text="{Binding InstallTargetSummary}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{DynamicResource Text.BodyMutedStyle}"
                                               Text="{Binding InstallResultSummary}"
                                               Visibility="{Binding HasInstallResultSummary, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>

                                <Border Grid.Row="1"
                                        Margin="0,6,0,0"
                                        MinHeight="188"
                                        Style="{StaticResource RightPanelDraftSurfaceStyle}">
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="Результаты установки появятся здесь.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.BodyMutedStyle}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasInstallResults}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <ListBox ItemsSource="{Binding InstallResults}"
                                                 ItemContainerStyle="{StaticResource InstallResultListBoxItemStyle}">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox" BasedOn="{StaticResource WorkbenchListBoxStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasInstallResults}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       Text="{Binding ApkDisplayName}" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       Style="{DynamicResource Text.CaptionStyle}"
                                                                       Text="{Binding DeviceDisplayName}" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       Style="{DynamicResource Text.CaptionStyle}"
                                                                       Text="{Binding Message}" />
                                                        </StackPanel>

                                                        <Border Grid.Column="1"
                                                                Margin="8,0,0,0"
                                                                Padding="8,2"
                                                                VerticalAlignment="Top"
                                                                CornerRadius="8">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSelection}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentSoft}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSelection}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentSoft}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerBorder}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Text="{Binding StatusText}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentPrimary}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentPrimary}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.DangerPrimary}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>
                            </TabItem>

                            <TabItem Header="На ТВ"
                                     IsSelected="{Binding IsPackagesTabSelected, Mode=TwoWay}">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Style="{DynamicResource TextBoxInputStyle}"
                                             Text="{Binding PackageSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Имя пакета" />

                                    <Button Grid.Column="2"
                                            Command="{Binding RefreshPackagesCommand}"
                                            Content="Обновить"
                                            Style="{DynamicResource SecondaryButtonStyle}" />

                                    <Button Grid.Column="4"
                                            Command="{Binding UninstallSelectedPackagesCommand}"
                                            Content="Удалить с ТВ"
                                            Style="{DynamicResource DangerButtonStyle}" />
                                </Grid>

                                <StackPanel Grid.Row="1"
                                            Margin="0,8,0,0"
                                            Orientation="Horizontal">
                                    <TextBlock Style="{DynamicResource Text.CaptionStyle}"
                                               Text="{Binding InstalledPackagesSummary}" />
                                    <TextBlock Margin="12,0,0,0"
                                               Style="{DynamicResource Text.CaptionStyle}"
                                               Text="{Binding InstalledPackageSelectionSummary}" />
                                    <TextBlock Margin="12,0,0,0"
                                               Style="{DynamicResource Text.BodyMutedStyle}"
                                               Text="{Binding PackagesStatusText}"
                                               Visibility="{Binding HasPackagesStatusText, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </StackPanel>

                                <Border Grid.Row="2"
                                        Margin="0,6,0,0"
                                        MinHeight="188"
                                        Style="{StaticResource RightPanelDraftSurfaceStyle}">
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding InstalledPackagesEmptyMessage}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.BodyMutedStyle}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasInstalledPackages}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <ListBox ItemsSource="{Binding InstalledPackages}"
                                                 SelectionMode="Extended"
                                                 behaviors:ListSelectionBehavior.SelectedItems="{Binding SelectedInstalledPackages}"
                                                 ItemContainerStyle="{DynamicResource WorkbenchListBoxItemStyle}">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox" BasedOn="{StaticResource WorkbenchListBoxStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasInstalledPackages}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                            <ListBox.InputBindings>
                                                <KeyBinding Key="Delete"
                                                            Command="{Binding UninstallSelectedPackagesCommand}" />
                                            </ListBox.InputBindings>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>
                                                            <TextBlock FontWeight="SemiBold"
                                                                       Text="{Binding PackageName}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,4,0,0"
                                                                       Style="{DynamicResource Text.CaptionStyle}"
                                                                       Text="{Binding MetaText}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>

                                                        <Border Grid.Column="1"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Top"
                                                                Style="{StaticResource PackagePresenceBadgeStyle}">
                                                            <TextBlock FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Brush.AccentPrimary}"
                                                                       Text="{Binding PresenceText}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Border>
    </Grid>
</UserControl>
