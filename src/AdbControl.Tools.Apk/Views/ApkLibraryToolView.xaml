<UserControl x:Class="AdbControl.Tools.Apk.Views.ApkLibraryToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:AdbControl.Tools.Apk.Behaviors"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="DropZoneStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.BackgroundSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDropActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.AccentSelection}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentPrimary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SortToggleButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.AccentPrimary}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SortDirectionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource PanelSurfaceStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{DynamicResource Text.PageTitleStyle}"
                           Text="APK" />

                <Border Grid.Column="2"
                        AllowDrop="True"
                        DragEnter="OnDropZoneDragEnter"
                        DragLeave="OnDropZoneDragLeave"
                        DragOver="OnDropZoneDragOver"
                        Drop="OnDropZoneDrop"
                        MouseLeftButtonUp="OnDropZoneClick"
                        Style="{StaticResource DropZoneStyle}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="Перетащи APK сюда или нажми, чтобы добавить" />
                </Border>

                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Margin="0,8,0,0"
                           Style="{DynamicResource Text.BodyMutedStyle}"
                           Text="{Binding StatusText}"
                           Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVisibilityConverter}}" />

                <StackPanel Grid.Row="1"
                            Grid.Column="2"
                            Margin="0,12,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Margin="0,0,8,0"
                            Command="{Binding InstallSelectedCommand}"
                            Content="Установить"
                            Style="{DynamicResource PrimaryButtonStyle}" />
                    <Button Command="{Binding DeleteSelectedCommand}"
                            Content="Удалить выбранные"
                            Style="{DynamicResource DangerButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="19*" />
                <ColumnDefinition Width="21*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,6,0"
                    Style="{DynamicResource PanelSurfaceStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{DynamicResource Text.SectionTitleStyle}"
                               Text="Мои APK" />

                    <StackPanel Grid.Row="1"
                                Margin="0,12,0,0"
                                Orientation="Horizontal">
                        <RadioButton Content="Название"
                                     GroupName="ApkSortField"
                                     IsChecked="{Binding IsSortByName}"
                                     Style="{StaticResource SortToggleButtonStyle}" />
                        <RadioButton Margin="8,0,0,0"
                                     Content="Дата"
                                     GroupName="ApkSortField"
                                     IsChecked="{Binding IsSortByDate}"
                                     Style="{StaticResource SortToggleButtonStyle}" />
                        <RadioButton Margin="8,0,0,0"
                                     Content="Размер"
                                     GroupName="ApkSortField"
                                     IsChecked="{Binding IsSortBySize}"
                                     Style="{StaticResource SortToggleButtonStyle}" />
                        <Button Margin="12,0,0,0"
                                Command="{Binding ToggleSortDirectionCommand}"
                                Content="{Binding SortDirectionGlyph}"
                                Style="{StaticResource SortDirectionButtonStyle}" />
                    </StackPanel>

                    <Grid Grid.Row="2"
                          Margin="0,12,0,0">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding EmptyStateMessage}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.BodyMutedStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEntries}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListBox ItemsSource="{Binding Entries}"
                                 SelectionMode="Extended"
                                 behaviors:ListBoxSelectionBehavior.SelectedItems="{Binding SelectedEntries}"
                                 ItemContainerStyle="{DynamicResource WorkbenchListBoxItemStyle}">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource WorkbenchListBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasEntries}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.InputBindings>
                                <KeyBinding Key="Delete"
                                            Command="{Binding DeleteSelectedCommand}" />
                            </ListBox.InputBindings>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding DisplayName}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{DynamicResource Text.CaptionStyle}"
                                                   Text="{Binding MetaText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="6,0,0,0"
                    Style="{DynamicResource PanelSurfaceStyle}" />
        </Grid>
    </Grid>
</UserControl>
