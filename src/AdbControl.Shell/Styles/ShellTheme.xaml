<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AdbControl.Shell;component/Styles/Colors.xaml" />
        <ResourceDictionary Source="/AdbControl.Shell;component/Styles/Metrics.xaml" />
        <ResourceDictionary Source="/AdbControl.Shell;component/Styles/Typography.xaml" />
        <ResourceDictionary Source="/AdbControl.Shell;component/Styles/Panels.xaml" />
        <ResourceDictionary Source="/AdbControl.Shell;component/Styles/Buttons.xaml" />
        <ResourceDictionary Source="/AdbControl.Shell;component/Styles/Inputs.xaml" />
        <ResourceDictionary Source="/AdbControl.Shell;component/Styles/Menus.xaml" />
        <ResourceDictionary Source="/AdbControl.Shell;component/Styles/Lists.xaml" />
        <ResourceDictionary Source="/AdbControl.Shell;component/Styles/Tabs.xaml" />
        <ResourceDictionary Source="/AdbControl.Shell;component/Styles/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Гасим стандартную рамку фокуса WPF. По умолчанию каждый фокусируемый элемент
        рисует поверх себя пунктирный чёрный прямоугольник, причём в слое адорнеров:
        он появляется по щелчку мышью и остаётся висеть, читаясь как мусор на экране.
        Собственная индикация в теме уже есть: у полей и списков — акцентная рамка
        по IsKeyboardFocused, у строк списка — акцентная заливка выделения.
    -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate />
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
