<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.AccentPrimary">#FF10B981</Color>
    <Color x:Key="Color.AccentHover">#FF059669</Color>
    <Color x:Key="Color.AccentSoft">#FF34D399</Color>
    <Color x:Key="Color.AccentSelection">#FFDCFCE7</Color>

    <Color x:Key="Color.BackgroundPrimary">#FFF7F9FC</Color>
    <Color x:Key="Color.BackgroundSecondary">#FFEEF2F7</Color>

    <Color x:Key="Color.SurfacePrimary">#FFFFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#FFF1F5F9</Color>

    <Color x:Key="Color.BorderDefault">#FFE2E8F0</Color>

    <Color x:Key="Color.TextPrimary">#FF0F172A</Color>
    <Color x:Key="Color.TextSecondary">#FF475569</Color>
    <Color x:Key="Color.TextDisabled">#FF94A3B8</Color>

    <Color x:Key="Color.LogoBase">#FF111827</Color>

    <Color x:Key="Color.DarkBackground">#FF0F172A</Color>
    <Color x:Key="Color.DarkSurface">#FF111827</Color>
    <Color x:Key="Color.DarkText">#FFE5E7EB</Color>

    <SolidColorBrush x:Key="Brush.AccentPrimary" Color="{StaticResource Color.AccentPrimary}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.AccentSelection" Color="{StaticResource Color.AccentSelection}" />

    <SolidColorBrush x:Key="Brush.BackgroundPrimary" Color="{StaticResource Color.BackgroundPrimary}" />
    <SolidColorBrush x:Key="Brush.BackgroundSecondary" Color="{StaticResource Color.BackgroundSecondary}" />

    <SolidColorBrush x:Key="Brush.SurfacePrimary" Color="{StaticResource Color.SurfacePrimary}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />

    <SolidColorBrush x:Key="Brush.BorderDefault" Color="{StaticResource Color.BorderDefault}" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />

    <SolidColorBrush x:Key="Brush.LogoBase" Color="{StaticResource Color.LogoBase}" />
</ResourceDictionary>
