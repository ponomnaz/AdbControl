<Window x:Class="AdbControl.Shell.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AdbControl"
        Width="1080"
        Height="720"
        MinWidth="960"
        MinHeight="620"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource Brush.BackgroundPrimary}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="8"
                Style="{DynamicResource PanelSurfaceStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Image Width="56"
                           Height="56"
                           Source="{StaticResource Image.AppLogo}"
                           Stretch="Uniform" />
                    <TextBlock Margin="0,16,0,0"
                               Style="{DynamicResource Text.PageTitleStyle}"
                               Text="AdbControl" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{DynamicResource Text.BodyMutedStyle}"
                               Text="Управление Android TV по ADB." />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,20,0,0">
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,8"
                                        Command="{Binding OpenCommand}"
                                        Style="{DynamicResource ToolNavigationButtonStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{DynamicResource IconChipStyle}">
                                            <TextBlock VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Style="{DynamicResource Text.CaptionStyle}"
                                                       Text="{Binding Glyph}" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Title}" />
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                Margin="10,0,0,0"
                                                MinWidth="18"
                                                Height="18"
                                                Padding="4,0"
                                                Background="{DynamicResource Brush.DangerPrimary}"
                                                CornerRadius="9"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasAttention}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding AttentionCount}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Margin="0,8,8,8"
                Padding="0"
                Style="{DynamicResource PanelSurfaceStyle}">
            <ContentPresenter Content="{Binding Workspace.ActiveTab.ContentViewModel}" />
        </Border>
    </Grid>
</Window>
