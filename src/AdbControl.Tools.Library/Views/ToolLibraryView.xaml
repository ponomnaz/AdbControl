<UserControl x:Class="AdbControl.Tools.Library.Views.ToolLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="6">
            <Border Style="{DynamicResource PanelSurfaceStyle}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.PageTitleStyle}"
                               Text="Разделы" />
                    <TextBlock Margin="0,10,0,0"
                               Style="{DynamicResource Text.BodyMutedStyle}"
                               Text="Все доступные экраны приложения." />
                </StackPanel>
            </Border>

            <ItemsControl Margin="0,20,0,0" ItemsSource="{Binding ToolCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300"
                                Margin="0,0,14,14"
                                Style="{DynamicResource PanelSurfaceStyle}">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <Border Width="32"
                                            Height="32"
                                            Style="{DynamicResource IconChipStyle}">
                                        <TextBlock VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Style="{DynamicResource Text.CaptionStyle}"
                                                   Text="{Binding Glyph}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <Button DockPanel.Dock="Right"
                                            Margin="10,0,0,0"
                                            Command="{Binding OpenCommand}"
                                            Content="Открыть"
                                            Style="{DynamicResource PrimaryButtonStyle}" />
                                </DockPanel>
                                <TextBlock Margin="0,14,0,0"
                                           Text="{Binding Title}"
                                           Style="{DynamicResource Text.SectionTitleStyle}" />
                                <TextBlock Margin="0,8,0,0"
                                           Style="{DynamicResource Text.BodyMutedStyle}"
                                           Text="{Binding Description}" />
                                <TextBlock Margin="0,12,0,0"
                                           Style="{DynamicResource Text.CaptionStyle}"
                                           Text="{Binding ModuleName, StringFormat=Модуль: {0}}" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{DynamicResource Text.CaptionStyle}"
                                           Text="{Binding Category, StringFormat=Категория: {0}}" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{DynamicResource Text.CaptionStyle}"
                                           Text="{Binding TargetScope, StringFormat=Устройства: {0}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
