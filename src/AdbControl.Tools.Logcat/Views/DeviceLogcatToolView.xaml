<UserControl x:Class="AdbControl.Tools.Logcat.Views.DeviceLogcatToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:AdbControl.Shell.Controls;assembly=AdbControl.Shell"
             xmlns:behaviors="clr-namespace:AdbControl.Shell.Behaviors;assembly=AdbControl.Shell"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="ConsoleListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasVisibleLines}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Строки лога плотные: отступы и рамки контейнера убраны,
             подсветка выделения оставлена акцентной. -->
        <Style x:Key="ConsoleLineItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- Список прокручивается по горизонтали, поэтому каждая строка меряется
                 по своему тексту. Без общей ширины подсветка обрывалась по концу строки
                 и выглядела рваными блоками. -->
            <Setter Property="MinWidth"
                    Value="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType=ItemsPresenter}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSelection}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ToolTip x:Key="LogcatLevelToolTip"
                 Placement="Bottom"
                 ToolTipService.InitialShowDelay="150"
                 ToolTipService.ShowDuration="20000">
            <TextBlock MaxWidth="300"
                       TextWrapping="Wrap"
                       Text="Порог важности, а не точное совпадение: «Warn и выше» покажет ещё и ошибки. Режет на устройстве — отсечённые строки не придут вовсе." />
        </ToolTip>

        <ToolTip x:Key="LogcatTagsToolTip"
                 Placement="Bottom"
                 ToolTipService.InitialShowDelay="150"
                 ToolTipService.ShowDuration="20000">
            <TextBlock MaxWidth="300"
                       TextWrapping="Wrap"
                       Text="Оставить только эти теги, остальные заглушить. Теги с двоеточием или пробелом logcat не принимает — такие строки убирай через «Скрывать»." />
        </ToolTip>

        <ToolTip x:Key="LogcatOnlyAppToolTip"
                 Placement="Bottom"
                 ToolTipService.InitialShowDelay="150"
                 ToolTipService.ShowDuration="20000">
            <TextBlock MaxWidth="300"
                       TextWrapping="Wrap"
                       Text="Только строки процесса cs.netarium. Идентификатор процесса отслеживается: после перезапуска приложения лог переподключится сам." />
        </ToolTip>

        <ToolTip x:Key="LogcatExtraToolTip"
                 Placement="Bottom"
                 ToolTipService.InitialShowDelay="150"
                 ToolTipService.ShowDuration="20000">
            <TextBlock MaxWidth="300"
                       TextWrapping="Wrap"
                       Text="Сырые аргументы adb logcat для редких случаев: -b all, -v time. Подставляются последними и могут перебить остальные настройки." />
        </ToolTip>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource PanelSurfaceStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовок и действия — тоже переносимая компоновка. В колонке Auto
                     WrapPanel меряется бесконечной шириной и никогда не переносится,
                     выдавливая заголовок в ноль: из-за этого «Logcat» и уезжал. -->
                <WrapPanel>
                    <StackPanel MinWidth="200"
                                Margin="0,0,16,8">
                        <TextBlock Style="{DynamicResource Text.PageTitleStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="Logcat" />
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Margin="0,0,12,0"
                                       Style="{DynamicResource Text.CaptionStyle}"
                                       Text="{Binding DeviceSummary}" />
                            <TextBlock Margin="0,0,12,0"
                                       Style="{DynamicResource Text.CaptionStyle}"
                                       Text="{Binding LineSummary}" />
                            <TextBlock Style="{DynamicResource Text.BodyMutedStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding StatusText}" />
                        </WrapPanel>
                    </StackPanel>

                    <WrapPanel VerticalAlignment="Bottom">
                        <ComboBox Width="200"
                                  Margin="0,0,8,8"
                                  Style="{DynamicResource CompactComboBoxInputStyle}"
                                  ItemsSource="{Binding ConnectedDevices}"
                                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayText" />
                        <Button Margin="0,0,8,8"
                                Command="{Binding ClearScreenCommand}"
                                Content="Очистить экран"
                                Style="{DynamicResource SecondaryButtonStyle}" />
                        <Button Margin="0,0,8,8"
                                Command="{Binding ClearBufferCommand}"
                                Content="Очистить буфер"
                                Style="{DynamicResource SecondaryButtonStyle}" />
                        <Button Margin="0,0,8,8"
                                Command="{Binding StartCommand}"
                                Content="Старт"
                                Style="{DynamicResource PrimaryButtonStyle}" />
                        <Button Margin="0,0,0,8"
                                Command="{Binding StopCommand}"
                                Content="Стоп"
                                Style="{DynamicResource DangerButtonStyle}" />
                    </WrapPanel>
                </WrapPanel>

                <!-- Две группы фильтров, каждая своим столбиком. Переносятся целиком:
                     при узком окне вторая уходит под первую, а не рассыпается по полям. -->
                <WrapPanel Grid.Row="1"
                           Margin="0,4,0,0">
                    <Grid Margin="0,0,28,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="92" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Margin="0,0,8,6"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource Text.CaptionStyle}"
                                   Text="Уровень" />
                        <ComboBox Grid.Column="1"
                                  Width="150"
                                  Margin="0,0,0,6"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Style="{DynamicResource CompactComboBoxInputStyle}"
                                  ItemsSource="{Binding Levels}"
                                  SelectedItem="{Binding SelectedLevel, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayText"
                                  ToolTip="{StaticResource LogcatLevelToolTip}" />

                        <TextBlock Grid.Row="1"
                                   Margin="0,0,8,6"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource Text.CaptionStyle}"
                                   Text="Теги" />
                        <controls:TagInput Grid.Row="1"
                                           Grid.Column="1"
                                           Width="180"
                                           Margin="0,0,0,6"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Items="{Binding FilterTags}"
                                           Placeholder="тег + Enter"
                                           ToolTip="{StaticResource LogcatTagsToolTip}" />

                        <TextBlock Grid.Row="2"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource Text.CaptionStyle}"
                                   Text="Дополнительно" />
                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Orientation="Horizontal">
                            <TextBox Width="112"
                                     VerticalAlignment="Center"
                                     Style="{DynamicResource TextBoxInputStyle}"
                                     Text="{Binding ExtraArguments, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{StaticResource LogcatExtraToolTip}" />
                            <CheckBox Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Content="Только Netarium"
                                      IsChecked="{Binding OnlyNetarium, Mode=TwoWay}"
                                      ToolTip="{StaticResource LogcatOnlyAppToolTip}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="92" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Margin="0,0,8,6"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource Text.CaptionStyle}"
                                   Text="Показывать" />
                        <controls:TagInput Grid.Column="1"
                                           Width="200"
                                           Margin="0,0,0,6"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Items="{Binding IncludeTerms}"
                                           Placeholder="условие + Enter"
                                           ToolTip="Строка проходит, если содержит хотя бы одно условие. Пусто — проходят все." />

                        <TextBlock Grid.Row="1"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource Text.CaptionStyle}"
                                   Text="Скрывать" />
                        <controls:TagInput Grid.Row="1"
                                           Grid.Column="1"
                                           Width="200"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Items="{Binding ExcludeTerms}"
                                           Placeholder="условие + Enter"
                                           ToolTip="Строка прячется, если содержит хотя бы одно условие. Сильнее, чем «Показывать»." />
                    </Grid>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,6,0,0"
                Style="{DynamicResource PanelSurfaceStyle}">
            <Grid>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{Binding EmptyStateMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.BodyMutedStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasVisibleLines}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox x:Name="LogOutputList"
                         ItemsSource="{Binding VisibleLines}"
                         SelectionMode="Extended"
                         behaviors:ListSelectionBehavior.IsMarqueeEnabled="False"
                         behaviors:ListSelectionBehavior.SelectedItems="{Binding SelectedLines}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Style="{DynamicResource ConsoleListBoxStyle}"
                         ItemContainerStyle="{DynamicResource ConsoleLineItemStyle}">
                    <ListBox.InputBindings>
                        <KeyBinding Key="C"
                                    Modifiers="Control"
                                    Command="{Binding CopySelectedCommand}" />
                    </ListBox.InputBindings>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}"
                                       TextWrapping="NoWrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.DangerPrimary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
