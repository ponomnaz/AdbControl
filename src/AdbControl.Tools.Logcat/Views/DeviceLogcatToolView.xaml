<UserControl x:Class="AdbControl.Tools.Logcat.Views.DeviceLogcatToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="LogcatLineItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource PanelSurfaceStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.PageTitleStyle}" Text="Logcat" />
                        <StackPanel Margin="0,8,0,0"
                                    Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource Text.CaptionStyle}"
                                       Text="{Binding DeviceSummary}" />
                            <TextBlock Margin="12,0,0,0"
                                       Style="{DynamicResource Text.CaptionStyle}"
                                       Text="{Binding LineSummary}" />
                            <TextBlock Margin="12,0,0,0"
                                       Style="{DynamicResource Text.BodyMutedStyle}"
                                       Text="{Binding StatusText}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="16,0,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Bottom">
                        <ComboBox Width="220"
                                  Margin="0,0,8,0"
                                  Style="{DynamicResource CompactComboBoxInputStyle}"
                                  ItemsSource="{Binding ConnectedDevices}"
                                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayText" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding StartCommand}"
                                Content="Старт"
                                Style="{DynamicResource PrimaryButtonStyle}" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding StopCommand}"
                                Content="Стоп"
                                Style="{DynamicResource DangerButtonStyle}" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding ClearScreenCommand}"
                                Content="Очистить экран"
                                Style="{DynamicResource SecondaryButtonStyle}" />
                        <Button Command="{Binding ClearBufferCommand}"
                                Content="Очистить буфер"
                                Style="{DynamicResource SecondaryButtonStyle}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Style="{DynamicResource Text.CaptionStyle}"
                               Text="Фильтр" />

                    <TextBox Grid.Column="1"
                             Margin="8,0,0,0"
                             Style="{DynamicResource TextBoxInputStyle}"
                             Text="{Binding FilterArguments, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Например: ActivityManager:I *:S" />

                    <TextBlock Grid.Column="3"
                               VerticalAlignment="Center"
                               Style="{DynamicResource Text.CaptionStyle}"
                               Text="Поиск" />

                    <TextBox Grid.Column="4"
                             Margin="8,0,0,0"
                             Style="{DynamicResource TextBoxInputStyle}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Поиск по уже показанным строкам" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,6,0,0"
                Style="{DynamicResource PanelSurfaceStyle}">
            <Grid>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{Binding EmptyStateMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.BodyMutedStyle}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasVisibleLines}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox x:Name="LogLinesListBox"
                         ItemsSource="{Binding VisibleLines}"
                         ItemContainerStyle="{StaticResource LogcatLineItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Style>
                        <Style TargetType="ListBox" BasedOn="{StaticResource WorkbenchListBoxStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasVisibleLines}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas"
                                       FontSize="13"
                                       Text="{Binding Text}"
                                       TextWrapping="NoWrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.DangerPrimary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
