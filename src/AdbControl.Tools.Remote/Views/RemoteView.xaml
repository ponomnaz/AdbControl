<UserControl x:Class="AdbControl.Tools.Remote.Views.RemoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:AdbControl.Tools.Remote.ViewModels"
             xmlns:views="clr-namespace:AdbControl.Tools.Remote.Views"
             xmlns:remote="clr-namespace:AdbControl.Application.Remote;assembly=AdbControl.Application"
             d:DataContext="{d:DesignInstance viewModels:RemoteViewModel}"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="RemoteButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="RemoteDpadButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="RemoteOkButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="52" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{DynamicResource PanelSurfaceStyle}">
            <!-- Переносимая компоновка: в колонке Auto панель управления мерялась бы
                 бесконечной шириной и выдавливала заголовок со сводкой в ноль. -->
            <WrapPanel>
                <StackPanel MinWidth="200"
                            Margin="0,0,16,8">
                    <TextBlock Style="{DynamicResource Text.PageTitleStyle}"
                               TextTrimming="CharacterEllipsis"
                               Text="Пульт" />
                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Margin="0,0,12,0"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{DynamicResource Text.CaptionStyle}"
                                   Text="{Binding DeviceSummary}" />
                        <TextBlock Margin="0,0,12,0"
                                   MaxWidth="320"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{DynamicResource Text.BodyMutedStyle}"
                                   Text="{Binding StatusText}"
                                   ToolTip="{Binding StatusText}" />
                        <TextBlock MaxWidth="320"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{DynamicResource Text.BodyMutedStyle}"
                                   Text="{Binding DisplayStatus}"
                                   ToolTip="{Binding DisplayStatus}" />
                    </WrapPanel>
                </StackPanel>

                <WrapPanel VerticalAlignment="Bottom">
                    <ComboBox Width="220"
                              Margin="0,0,8,8"
                              Style="{DynamicResource CompactComboBoxInputStyle}"
                              ItemsSource="{Binding ConnectedDevices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="DisplayText" />

                    <!-- Выбор применяется к телевизору сразу: отдельной кнопки нет намеренно.
                         Пункт сброса несёт физическое значение, поэтому подписи не нужны. -->
                    <ComboBox Width="200"
                              Margin="0,0,8,8"
                              Style="{DynamicResource CompactComboBoxInputStyle}"
                              IsEnabled="{Binding IsDisplayControlEnabled}"
                              ItemsSource="{Binding SizeOptions}"
                              SelectedItem="{Binding SelectedSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="DisplayText"
                              ToolTip="Разрешение экрана. Применяется сразу, интерфейс телевизора перерисуется." />

                    <ComboBox Width="190"
                              Margin="0,0,8,8"
                              Style="{DynamicResource CompactComboBoxInputStyle}"
                              IsEnabled="{Binding IsDisplayControlEnabled}"
                              ItemsSource="{Binding DensityOptions}"
                              SelectedItem="{Binding SelectedDensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="DisplayText"
                              ToolTip="Плотность экрана в dpi. Чем меньше, тем мельче интерфейс и больше влезает." />

                    <Button Margin="0,0,8,8"
                            Command="{Binding StartMirroringCommand}"
                            Content="Трансляция"
                            Style="{DynamicResource PrimaryButtonStyle}" />
                    <Button Margin="0,0,0,8"
                            Command="{Binding StopMirroringCommand}"
                            Content="Стоп"
                            Style="{DynamicResource DangerButtonStyle}" />
                </WrapPanel>
            </WrapPanel>
        </Border>

        <!-- Content: screen + remote -->
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Screen area -->
            <Border Grid.Column="0"
                    Margin="0,0,6,0"
                    Style="{DynamicResource PanelSurfaceStyle}">
                <Grid>
                    <!--
                        ScrcpyHost starts Hidden (not Collapsed): the Win32 host HWND is created
                        but not shown, so WPF elements below are fully visible.
                        Code-behind switches it to Visible only after the scrcpy window is attached.
                    -->
                    <views:ScrcpyWindowHost x:Name="ScrcpyHost" Visibility="Hidden" />

                    <!-- Loading spinner: shown while connecting (ScrcpyHost is Hidden → no airspace) -->
                    <StackPanel x:Name="LoadingPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <ProgressBar IsIndeterminate="True"
                                     Width="160"
                                     Height="4"
                                     Margin="0,0,0,12" />
                        <TextBlock HorizontalAlignment="Center"
                                   Style="{DynamicResource Text.BodyMutedStyle}"
                                   Text="Подключение трансляции…" />
                    </StackPanel>

                    <!-- Empty / idle state -->
                    <TextBlock x:Name="EmptyStateText"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Style="{DynamicResource Text.BodyMutedStyle}"
                               Text="{Binding EmptyStateMessage}"
                               Visibility="{Binding IsMirroring, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
            </Border>

            <!-- Remote control panel -->
            <Border Grid.Column="1"
                    Width="188"
                    Style="{DynamicResource PanelSurfaceStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Center">

                        <!-- Power -->
                        <Button Content="⏻"
                                Style="{StaticResource RemoteButtonStyle}"
                                HorizontalAlignment="Center"
                                ToolTip="Power"
                                Margin="0,0,0,10"
                                Command="{Binding SendKeyCommand}"
                                CommandParameter="{x:Static remote:RemoteKeyCode.Power}" />

                        <Separator Margin="0,0,0,10" />

                        <!-- Media -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Button Content="⏮" Style="{StaticResource RemoteButtonStyle}"
                                    ToolTip="Rewind" Margin="0,0,6,0"
                                    Command="{Binding SendKeyCommand}"
                                    CommandParameter="{x:Static remote:RemoteKeyCode.MediaRewind}" />
                            <Button Content="⏯" Style="{StaticResource RemoteButtonStyle}"
                                    ToolTip="Play / Pause" Margin="0,0,6,0"
                                    Command="{Binding SendKeyCommand}"
                                    CommandParameter="{x:Static remote:RemoteKeyCode.MediaPlayPause}" />
                            <Button Content="⏭" Style="{StaticResource RemoteButtonStyle}"
                                    ToolTip="Fast Forward"
                                    Command="{Binding SendKeyCommand}"
                                    CommandParameter="{x:Static remote:RemoteKeyCode.MediaFastForward}" />
                        </StackPanel>

                        <Separator Margin="0,0,0,10" />

                        <!-- D-Pad -->
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Row="0" Grid.Column="1" Content="▲"
                                    Style="{StaticResource RemoteDpadButtonStyle}" ToolTip="Up"
                                    Command="{Binding SendKeyCommand}"
                                    CommandParameter="{x:Static remote:RemoteKeyCode.DpadUp}" />
                            <Button Grid.Row="1" Grid.Column="0" Content="◀"
                                    Style="{StaticResource RemoteDpadButtonStyle}" ToolTip="Left"
                                    Command="{Binding SendKeyCommand}"
                                    CommandParameter="{x:Static remote:RemoteKeyCode.DpadLeft}" />
                            <Button Grid.Row="1" Grid.Column="1" Content="OK"
                                    Style="{StaticResource RemoteOkButtonStyle}" ToolTip="OK / Select"
                                    Command="{Binding SendKeyCommand}"
                                    CommandParameter="{x:Static remote:RemoteKeyCode.DpadCenter}" />
                            <Button Grid.Row="1" Grid.Column="2" Content="▶"
                                    Style="{StaticResource RemoteDpadButtonStyle}" ToolTip="Right"
                                    Command="{Binding SendKeyCommand}"
                                    CommandParameter="{x:Static remote:RemoteKeyCode.DpadRight}" />
                            <Button Grid.Row="2" Grid.Column="1" Content="▼"
                                    Style="{StaticResource RemoteDpadButtonStyle}" ToolTip="Down"
                                    Command="{Binding SendKeyCommand}"
                                    CommandParameter="{x:Static remote:RemoteKeyCode.DpadDown}" />
                        </Grid>

                        <Separator Margin="0,0,0,10" />

                        <!-- Home / Back / Menu -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Button Content="⌂" Style="{StaticResource RemoteButtonStyle}"
                                    ToolTip="Home" Margin="0,0,6,0"
                                    Command="{Binding SendKeyCommand}"
                                    CommandParameter="{x:Static remote:RemoteKeyCode.Home}" />
                            <Button Content="←" Style="{StaticResource RemoteButtonStyle}"
                                    ToolTip="Back" Margin="0,0,6,0"
                                    Command="{Binding SendKeyCommand}"
                                    CommandParameter="{x:Static remote:RemoteKeyCode.Back}" />
                            <Button Content="☰" Style="{StaticResource RemoteButtonStyle}"
                                    ToolTip="Menu"
                                    Command="{Binding SendKeyCommand}"
                                    CommandParameter="{x:Static remote:RemoteKeyCode.Menu}" />
                        </StackPanel>

                        <Separator Margin="0,0,0,10" />

                        <!-- Volume -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="－" Style="{StaticResource RemoteButtonStyle}"
                                    ToolTip="Volume Down" Margin="0,0,6,0"
                                    Command="{Binding SendKeyCommand}"
                                    CommandParameter="{x:Static remote:RemoteKeyCode.VolumeDown}" />
                            <Button Content="🔇" Style="{StaticResource RemoteButtonStyle}"
                                    ToolTip="Mute" Margin="0,0,6,0"
                                    Command="{Binding SendKeyCommand}"
                                    CommandParameter="{x:Static remote:RemoteKeyCode.VolumeMute}" />
                            <Button Content="＋" Style="{StaticResource RemoteButtonStyle}"
                                    ToolTip="Volume Up"
                                    Command="{Binding SendKeyCommand}"
                                    CommandParameter="{x:Static remote:RemoteKeyCode.VolumeUp}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
