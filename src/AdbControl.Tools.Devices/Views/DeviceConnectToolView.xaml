<UserControl x:Class="AdbControl.Tools.Devices.Views.DeviceConnectToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:AdbControl.Tools.Devices.Behaviors"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="DiscoveredDevicePrimaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditingAlias}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DiscoveredAliasEditorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxInputStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="ToolTip" Value="Имя телевизора" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditingAlias}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DiscoveredDeviceSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.CaptionStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSecondaryText}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditingAlias}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AutoConnectToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Control}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentPrimary}" />
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSelection}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSelection}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource PanelSurfaceStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.PageTitleStyle}" Text="Подключение" />
                    <StackPanel Margin="0,8,0,0"
                                Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource Text.CaptionStyle}"
                                   Text="{Binding DiscoverySummary}" />
                        <TextBlock Margin="12,0,0,0"
                                   Style="{DynamicResource Text.CaptionStyle}"
                                   Text="{Binding SelectionSummary}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            Content="Сканировать"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button Command="{Binding StopScanCommand}"
                            Content="Стоп"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                </StackPanel>

                <ProgressBar Grid.Row="1"
                             Grid.ColumnSpan="2"
                             Height="3"
                             Margin="0,10,0,0"
                             BorderThickness="0"
                             Minimum="0"
                             Maximum="1"
                             Background="{DynamicResource Brush.SurfaceAlt}"
                             Foreground="{DynamicResource Brush.AccentPrimary}"
                             Value="{Binding ScanProgressFraction, Mode=OneWay}">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <Grid Grid.Row="2"
                      Grid.ColumnSpan="2"
                      Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Style="{DynamicResource Text.CaptionStyle}"
                               Text="Сеть" />
                    <TextBox Grid.Column="1"
                             MinWidth="260"
                             Margin="8,0,8,0"
                             Style="{DynamicResource TextBoxInputStyle}"
                             Text="{Binding ScanTargetInput, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Пусто — локальные подсети. Иначе: 212.59.101.0/24, 212.59.101.1-254, 212.59.101.75, tv.local:5555. Через запятую можно несколько.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                                        Command="{Binding RefreshCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Style="{DynamicResource Text.CaptionStyle}"
                               Text="Порты" />
                    <TextBox Grid.Column="3"
                             MinWidth="120"
                             Margin="8,0,0,0"
                             Style="{DynamicResource TextBoxInputStyle}"
                             Text="{Binding PortsInput, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Пусто — 5555. Иначе: 5555-5585 или 5555,5560-5570.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                                        Command="{Binding RefreshCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>

                <Grid Grid.Row="3"
                      Grid.ColumnSpan="2"
                      Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Style="{DynamicResource Text.CaptionStyle}"
                               Text="IP" />
                    <TextBox Grid.Column="1"
                             MinWidth="260"
                             Margin="8,0,8,0"
                             Style="{DynamicResource TextBoxInputStyle}"
                             Text="{Binding EndpointInput, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="IP:порт телевизора">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                                        Command="{Binding ConnectManualCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="2"
                            Margin="0,0,8,0"
                            Command="{Binding ConnectManualCommand}"
                            Content="Подключить"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button Grid.Column="3"
                            Margin="0,0,8,0"
                            Command="{Binding ConnectSelectedCommand}"
                            Content="Подключить выбранные"
                            Style="{DynamicResource PrimaryButtonStyle}" />
                    <Button Grid.Column="4"
                            Command="{Binding DisconnectSelectedCommand}"
                            Content="Отключить"
                            Style="{DynamicResource DangerButtonStyle}" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,8,0,0"
                Style="{DynamicResource PanelSurfaceStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ListBox Margin="0,0,0,0"
                         ItemsSource="{Binding DiscoveredDevicesView}"
                         SelectionMode="Extended"
                         behaviors:ListBoxSelectionBehavior.SelectedItems="{Binding SelectedCandidates}"
                         Style="{DynamicResource WorkbenchListBoxStyle}"
                         ItemContainerStyle="{DynamicResource WorkbenchListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel.ContextMenu>
                                        <ContextMenu DataContext="{Binding}">
                                            <MenuItem Header="Переименовать"
                                                      Click="OnRenameMenuItemClick" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource DiscoveredDevicePrimaryTextStyle}"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}" />
                                    <TextBox Style="{StaticResource DiscoveredAliasEditorTextBoxStyle}"
                                             Loaded="OnAliasEditorLoaded"
                                             IsVisibleChanged="OnAliasEditorIsVisibleChanged"
                                             LostFocus="OnAliasEditorLostFocus"
                                             KeyDown="OnAliasEditorKeyDown"
                                             Text="{Binding AliasDraft, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource DiscoveredDeviceSecondaryTextStyle}"
                                               Text="{Binding SecondaryText}" />
                                </StackPanel>

                                <ToggleButton Grid.Column="1"
                                              Margin="12,0,12,0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsAutoConnectEnabled, Mode=OneWay}"
                                              ToolTip="{Binding AutoConnectToolTip}"
                                              Command="{Binding DataContext.ToggleAutoConnectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding Endpoint}"
                                              Style="{StaticResource AutoConnectToggleButtonStyle}">
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="↻" />
                                </ToggleButton>

                                <TextBlock Grid.Column="2"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{DynamicResource Text.CaptionStyle}"
                                           Text="{Binding Status}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
