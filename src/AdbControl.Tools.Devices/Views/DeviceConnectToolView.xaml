<UserControl x:Class="AdbControl.Tools.Devices.Views.DeviceConnectToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:AdbControl.Tools.Devices.Behaviors"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource PanelSurfaceStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.PageTitleStyle}" Text="Подключение" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{DynamicResource Text.BodyMutedStyle}"
                               Text="{Binding StatusText}" />
                    <StackPanel Margin="0,8,0,0"
                                Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource Text.CaptionStyle}"
                                   Text="{Binding DiscoverySummary}" />
                        <TextBlock Margin="12,0,0,0"
                                   Style="{DynamicResource Text.CaptionStyle}"
                                   Text="{Binding SelectionSummary}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <Button Command="{Binding RefreshCommand}"
                            Content="Сканировать"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                </StackPanel>

                <Grid Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             MinWidth="260"
                             Margin="8,0,8,0"
                             Style="{DynamicResource TextBoxInputStyle}"
                             Text="{Binding EndpointInput, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter"
                                        Command="{Binding ConnectManualCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1"
                            Margin="0,0,8,0"
                            Command="{Binding ConnectManualCommand}"
                            Content="Подключить"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button Grid.Column="2"
                            Margin="0,0,8,0"
                            Command="{Binding DisconnectSelectedCommand}"
                            Content="Отключить"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button Grid.Column="3"
                            Command="{Binding ConnectSelectedCommand}"
                            Content="Подключить выбранные"
                            Style="{DynamicResource PrimaryButtonStyle}" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Style="{DynamicResource PanelSurfaceStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Style="{DynamicResource Text.SectionTitleStyle}"
                           Text="Найдено в сети" />

                <ListBox Grid.Row="1"
                         Margin="0,12,0,0"
                         ItemsSource="{Binding DiscoveredDevicesView}"
                         SelectionMode="Extended"
                         behaviors:ListBoxSelectionBehavior.SelectedItems="{Binding SelectedCandidates}"
                         Style="{DynamicResource WorkbenchListBoxStyle}"
                         ItemContainerStyle="{DynamicResource WorkbenchListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding Endpoint}" />
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{DynamicResource Text.CaptionStyle}"
                                           Text="{Binding Status}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
