<UserControl x:Class="AdbControl.Tools.Devices.Views.DevicesToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:behaviors="clr-namespace:AdbControl.Tools.Devices.Behaviors"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="AliasDisplayTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditingAlias}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AliasEditorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxInputStyle}">
            <Setter Property="ToolTip" Value="Имя телевизора" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditingAlias}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeviceSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.CaptionStyle}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSecondaryText}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditingAlias}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6"
          PreviewMouseDown="OnRootPreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource PanelSurfaceStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.PageTitleStyle}" Text="Устройства" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{DynamicResource Text.BodyMutedStyle}"
                               Text="{Binding StatusText}" />
                    <StackPanel Margin="0,8,0,0"
                                Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource Text.CaptionStyle}"
                                   Text="{Binding ConnectedSummary}" />
                        <TextBlock Margin="12,0,0,0"
                                   Style="{DynamicResource Text.CaptionStyle}"
                                   Text="{Binding SelectionSummary}" />
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1"
                      Margin="16,0,0,0"
                      VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <TextBox Width="220"
                                 Margin="0,0,8,0"
                                 Style="{DynamicResource TextBoxInputStyle}"
                                 Text="{Binding ServerEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="IP:порт сервера" />
                        <Button Width="88"
                                Command="{Binding ApplyServerCommand}"
                                Content="Сервер"
                                Style="{DynamicResource SecondaryButtonStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="0,8,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Width="124"
                                Margin="0,0,8,0"
                                Command="{Binding StopCommand}"
                                Content="Стоп Netarium"
                                Style="{DynamicResource SecondaryButtonStyle}" />
                        <Button Width="118"
                                Margin="0,0,8,0"
                                Command="{Binding RebootCommand}"
                                Content="Перезагрузка"
                                Style="{DynamicResource PrimaryButtonStyle}" />
                        <Button Width="90"
                                Command="{Binding PowerCommand}"
                                Content="Питание"
                                Style="{DynamicResource DangerButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,8,0,0"
                Style="{DynamicResource PanelSurfaceStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Style="{DynamicResource Text.SectionTitleStyle}"
                           Text="{Binding EmptyStateMessage}" />

                <ListBox Grid.Row="1"
                         Margin="0,12,0,0"
                         ItemsSource="{Binding KnownDevices}"
                         SelectionMode="Extended"
                         behaviors:ListBoxSelectionBehavior.SelectedItems="{Binding SelectedRows}"
                         Style="{DynamicResource WorkbenchListBoxStyle}"
                         ItemContainerStyle="{DynamicResource WorkbenchListBoxItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Background="Transparent">
                                    <StackPanel.ContextMenu>
                                        <ContextMenu DataContext="{Binding}">
                                            <MenuItem Header="Переименовать"
                                                      Click="OnRenameMenuItemClick" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <TextBlock Style="{StaticResource AliasDisplayTextStyle}"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}" />
                                    <TextBox Style="{StaticResource AliasEditorTextBoxStyle}"
                                             Loaded="OnAliasEditorLoaded"
                                             IsVisibleChanged="OnAliasEditorIsVisibleChanged"
                                             LostFocus="OnAliasEditorLostFocus"
                                             KeyDown="OnAliasEditorKeyDown"
                                             Text="{Binding AliasDraft, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Style="{StaticResource DeviceSecondaryTextStyle}"
                                               Text="{Binding SecondaryText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{DynamicResource Text.CaptionStyle}"
                                           Text="{Binding ConnectionKind}" />
                                <TextBlock Grid.Column="2"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Style="{DynamicResource Text.CaptionStyle}"
                                           Text="{Binding Reachability}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
