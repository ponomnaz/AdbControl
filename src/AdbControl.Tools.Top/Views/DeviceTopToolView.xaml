<UserControl x:Class="AdbControl.Tools.Top.Views.DeviceTopToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="VisibleWhenRawOutputMissingStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.CaptionStyle}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasRawOutput}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConsoleTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxInputStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <Style x:Key="VisibleWhenRawOutputExistsStyle" TargetType="TextBox" BasedOn="{StaticResource ConsoleTextBoxStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasRawOutput}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource PanelSurfaceStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.PageTitleStyle}" Text="Top" />
                    <StackPanel Margin="0,8,0,0"
                                Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource Text.CaptionStyle}"
                                   Text="{Binding ProcessSummary}" />
                        <TextBlock Margin="12,0,0,0"
                                   Style="{DynamicResource Text.CaptionStyle}"
                                   Text="{Binding SnapshotTimeText}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="16,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <ComboBox Width="240"
                              Margin="0,0,8,0"
                              Style="{DynamicResource CompactComboBoxInputStyle}"
                              ItemsSource="{Binding ConnectedDevices}"
                              SelectedItem="{Binding SelectedDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="DisplayText" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            Content="Обновить"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding StartCommand}"
                            Content="Старт"
                            Style="{DynamicResource PrimaryButtonStyle}" />
                    <Button Command="{Binding StopCommand}"
                            Content="Стоп"
                            Style="{DynamicResource DangerButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,6,0,0"
                Style="{DynamicResource PanelSurfaceStyle}">
            <Grid>
                <TextBlock Style="{StaticResource VisibleWhenRawOutputMissingStyle}"
                           Text="{Binding EmptyStateMessage}" />

                <TextBox AcceptsReturn="True"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         Style="{StaticResource VisibleWhenRawOutputExistsStyle}"
                         Text="{Binding RawOutput, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
