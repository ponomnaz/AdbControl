<UserControl x:Class="AdbControl.Tools.Top.Views.DeviceTopToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="SummaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.CaptionStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSummary}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VisibleWhenNoProcessesStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.BodyMutedStyle}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasProcesses}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProcessListStyle" TargetType="ListView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasProcesses}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Заголовки колонок: штатное оформление GridView выпадает из общего вида. -->
        <Style x:Key="ProcessColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.BorderDefault}"
                                BorderThickness="0,0,1,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProcessRowStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                  Columns="{TemplateBinding GridView.ColumnCollection}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Процесс приложения подсвечен: ради него сюда и заходят. -->
                            <DataTrigger Binding="{Binding IsNetarium}" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSelection}" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource PanelSurfaceStyle}">
            <StackPanel>
                <!-- Переносимая компоновка: в колонке Auto панель кнопок мерялась бы
                     бесконечной шириной и выдавливала заголовок в ноль. -->
                <WrapPanel>
                    <StackPanel MinWidth="200"
                                Margin="0,0,16,8">
                        <TextBlock Style="{DynamicResource Text.PageTitleStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="Top" />
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Margin="0,0,12,0"
                                       Style="{DynamicResource Text.CaptionStyle}"
                                       Text="{Binding ProcessSummary}" />
                            <TextBlock Margin="0,0,12,0"
                                       Style="{DynamicResource Text.CaptionStyle}"
                                       Text="{Binding SnapshotTimeText}" />
                            <TextBlock Style="{DynamicResource Text.BodyMutedStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding StatusText}" />
                        </WrapPanel>
                    </StackPanel>

                    <WrapPanel VerticalAlignment="Bottom">
                        <ComboBox Width="200"
                                  Margin="0,0,8,8"
                                  Style="{DynamicResource CompactComboBoxInputStyle}"
                                  ItemsSource="{Binding ConnectedDevices}"
                                  SelectedItem="{Binding SelectedDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="DisplayText" />
                        <Button Margin="0,0,8,8"
                                Command="{Binding RefreshCommand}"
                                Content="Снимок"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                ToolTip="Один замер прямо сейчас" />
                        <Button Margin="0,0,8,8"
                                Command="{Binding StartCommand}"
                                Content="Следить"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                ToolTip="Обновлять непрерывно с выбранным интервалом" />
                        <Button Margin="0,0,0,8"
                                Command="{Binding StopCommand}"
                                Content="Стоп"
                                Style="{DynamicResource DangerButtonStyle}" />
                    </WrapPanel>
                </WrapPanel>

                <WrapPanel>
                    <StackPanel Margin="0,0,20,0"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Style="{DynamicResource Text.CaptionStyle}"
                                   Text="Интервал" />
                        <ComboBox Width="80"
                                  VerticalAlignment="Center"
                                  Style="{DynamicResource CompactComboBoxInputStyle}"
                                  ItemsSource="{Binding Intervals}"
                                  SelectedItem="{Binding SelectedInterval, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayText"
                                  ToolTip="Как часто снимать top в режиме «Следить». Сам замер заметно грузит телевизор." />
                    </StackPanel>

                    <CheckBox VerticalAlignment="Center"
                              Content="Все процессы"
                              IsChecked="{Binding ShowAllProcesses, Mode=TwoWay}"
                              ToolTip="По умолчанию берутся 30 самых нагруженных. Полный список — это три сотни строк и заметно дороже для устройства." />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,6,0,0"
                Style="{DynamicResource PanelSurfaceStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,6">
                    <Border Padding="8,4"
                            Margin="0,0,0,6"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.AccentSelection}"
                            BorderBrush="{DynamicResource Brush.AccentSoft}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Control}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNetariumSummary}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   Text="{Binding NetariumSummary}" />
                    </Border>

                    <TextBlock FontFamily="Consolas"
                               Style="{StaticResource SummaryTextStyle}"
                               Text="{Binding SummaryText}" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource VisibleWhenNoProcessesStyle}"
                           Text="{Binding EmptyStateMessage}" />

                <ListView x:Name="ProcessList"
                          Grid.Row="1"
                          ItemsSource="{Binding Processes}"
                          Style="{StaticResource ProcessListStyle}"
                          ItemContainerStyle="{StaticResource ProcessRowStyle}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView x:Name="ProcessGrid"
                                  ColumnHeaderContainerStyle="{StaticResource ProcessColumnHeaderStyle}" />
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
