<?xml version="1.0" encoding="utf-8"?>
<WixLocalization xmlns="http://wixtoolset.org/schemas/v4/wxl"
                 Culture="ru-RU"
                 Language="1049">
  <String Id="Caption" Value="[WixBundleName] - установка" />
  <String Id="Title" Value="Подготовка установки [WixBundleName]" />
  <String Id="NonPrereqTitle" Value="Установка [WixBundleName]" />
  <String Id="ConfirmCancelMessage" Value="Вы действительно хотите отменить установку?" />
  <String Id="HelpHeader" Value="Справка" />
  <String Id="HelpText" Value="/passive | /quiet - показывает минимальный интерфейс без запросов или вовсе не показывает интерфейс. По умолчанию отображается полный интерфейс.&#xA;&#xA;/norestart - запрещает автоматическую перезагрузку. По умолчанию установщик предложит перезагрузку при необходимости.&#xA;&#xA;/log log.txt - пишет журнал в указанный файл. По умолчанию журнал создаётся в папке %TEMP%." />
  <String Id="HelpCloseButton" Value="Закрыть" />
  <String Id="InstallLicenseTerms" Value="Нажмите &quot;Принять и установить&quot;, чтобы принять условия лицензии для необходимого компонента." />
  <String Id="InstallAcceptAndInstallButton" Value="Принять и установить" />
  <String Id="InstallDeclineButton" Value="Отмена" />
  <String Id="ProgressHeader" Value="Ход установки" />
  <String Id="ProgressLabel" Value="Обработка:" />
  <String Id="ProgressCancelButton" Value="Отмена" />
  <String Id="SuccessHeader" Value="Установка зависимостей завершена" />
  <String Id="SuccessLayoutHeader" Value="Подготовка файлов завершена" />
  <String Id="SuccessRestartText" Value="Перед продолжением установки [WixBundleName] нужно перезагрузить компьютер." />
  <String Id="SuccessRestartButton" Value="Перезагрузить" />
  <String Id="SuccessCloseButton" Value="Закрыть" />
  <String Id="FailureHeader" Value="Не удалось завершить установку" />
  <String Id="FailureLayoutHeader" Value="Не удалось подготовить файлы" />
  <String Id="FailureLogLinkText" Value="Во время установки возникли ошибки. Исправьте их и попробуйте снова. Подробнее см. в &lt;a href=&quot;#&quot;&gt;журнале&lt;/a&gt;." />
  <String Id="FailureRestartText" Value="Чтобы завершить откат изменений, необходимо перезагрузить компьютер." />
  <String Id="FailureRestartButton" Value="Перезагрузить" />
  <String Id="FailureCloseButton" Value="Закрыть" />
  <String Id="PREREQBAINFINITELOOPErrorMessage" Value="Не удалось запустить [WixBundleName], хотя все необходимые компоненты уже установлены." />
  <String Id="FilesInUseTitle" Value="Файлы заняты" />
  <String Id="FilesInUseLabel" Value="Следующие приложения используют файлы, которые нужно обновить:" />
  <String Id="FilesInUseNetfxCloseRadioButton" Value="Закрыть приложения." />
  <String Id="FilesInUseCloseRadioButton" Value="Закрыть приложения и попытаться запустить их снова." />
  <String Id="FilesInUseDontCloseRadioButton" Value="Не закрывать приложения. Потребуется перезагрузка." />
  <String Id="FilesInUseRetryButton" Value="Повторить" />
  <String Id="FilesInUseIgnoreButton" Value="Игнорировать" />
  <String Id="FilesInUseExitButton" Value="Выход" />
</WixLocalization>
