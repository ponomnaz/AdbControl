<Project Sdk="WixToolset.Sdk/6.0.0">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <EnableDefaultItems>false</EnableDefaultItems>
    <BundleVersion Condition="'$(BundleVersion)' == ''">0.1.0</BundleVersion>
    <BundleName Condition="'$(BundleName)' == ''">AdbControl.Setup</BundleName>
    <MsiDir Condition="'$(MsiDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\artifacts\installer\win-x64\msi\</MsiDir>
    <DefineConstants>
      BundleVersion=$(BundleVersion);
      BundleName=$(BundleName);
      Manufacturer=ponomnaz;
      BundleIconPath=$(MSBuildThisFileDirectory)..\..\..\assets\icons\icon_adb.ico;
      SplashScreenPath=$(MSBuildThisFileDirectory)..\assets\splashscreen.bmp;
      BundleLogoPath=$(MSBuildThisFileDirectory)..\..\..\assets\icons\icon_adb.png;
      BundleLocalizationPath=$(MSBuildThisFileDirectory)Bundle.ru-RU.wxl
    </DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <BindPath Include="$(MsiDir)" BindName="InstallerMsi" />
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Bundle.wxs" />
  </ItemGroup>
</Project>
