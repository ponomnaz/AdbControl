<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="$(ProductName)"
      Manufacturer="$(Manufacturer)"
      Version="$(InstallerVersion)"
      UpgradeCode="{A3E209D8-5A49-413E-A7FE-C4E629D1C4C5}"
      Codepage="65001"
      Language="1049"
      Scope="perMachine">

    <SummaryInformation Description="Установщик AdbControl" />
    <MajorUpgrade DowngradeErrorMessage="Нельзя установить более старую версию AdbControl." />
    <MediaTemplate EmbedCab="yes" />
    <ui:WixUI Id="AdbControl_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <Icon Id="AppIcon.ico" SourceFile="$(AppIconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="$(ProductName)" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="$(ProductName)" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="$(ProductName)" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcutsComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutableComponent" Guid="*">
        <File Id="AdbControlExecutable" Source="!(bindpath.PublishDir)\AdbControl.exe" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>

      <Files Include="!(bindpath.PublishDir)\**">
        <Exclude Files="!(bindpath.PublishDir)\AdbControl.exe" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcutsComponent" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut
          Id="StartMenuShortcut"
          Name="$(ProductName)"
          Description="Запуск AdbControl"
          Target="[INSTALLFOLDER]AdbControl.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon.ico" />
      <Shortcut
          Id="StartMenuUninstallShortcut"
          Name="Удалить $(ProductName)"
          Description="Удаление AdbControl"
          Target="[INSTALLFOLDER]AdbControl.Uninstall.exe"
          Icon="AppIcon.ico" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\$(Manufacturer)\$(ProductName)"
          Name="StartMenuShortcuts"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="*" Condition="INSTALLDESKTOPSHORTCUT = &quot;1&quot;">
      <Shortcut
          Id="DesktopShortcut"
          Name="$(ProductName)"
          Description="Запуск AdbControl"
          Target="[INSTALLFOLDER]AdbControl.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon.ico" />
      <RemoveFile Id="RemoveDesktopShortcutFile" Name="AdbControl.lnk" On="uninstall" />
      <RegistryValue
          Root="HKCU"
          Key="Software\$(Manufacturer)\$(ProductName)"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
    </Component>

  </Fragment>
</Wix>
