<Window x:Class="AdbControl.SetupHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка AdbControl"
        Width="980"
        Height="640"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F7F9FC">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#10B981" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#059669" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MutedSurfaceBrush" Color="#F1F5F9" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E2E8F0" />
        <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#475569" />
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentDarkBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        </Style>

        <Style x:Key="FieldStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="304" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#0F172A"
                Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Width="58"
                            Height="58"
                            Background="Transparent"
                            CornerRadius="0"
                            Padding="0">
                        <Image Source="Assets/icon_adb.png" Stretch="Uniform" />
                    </Border>

                    <TextBlock Margin="0,18,0,0"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Text="AdbControl" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="#CBD5E1"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Text="Установка приложения" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,40,0,0"
                            VerticalAlignment="Top">
                    <Border x:Name="StepWelcomeCard"
                            Background="#132438"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="StepWelcomeBadge"
                                    Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="#10B981">
                                <TextBlock Text="1"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock x:Name="StepWelcomeTitle"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="Подготовка" />
                                <TextBlock x:Name="StepWelcomeSubtitle"
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           Text="Коротко о том, что будет установлено" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="StepOptionsCard"
                            Background="#111827"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="StepOptionsBadge"
                                    Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="#1E293B">
                                <TextBlock Text="2"
                                           Foreground="#CBD5E1"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock x:Name="StepOptionsTitle"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="Параметры" />
                                <TextBlock x:Name="StepOptionsSubtitle"
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           Text="Папка установки и ярлык" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="StepInstallCard"
                            Background="#111827"
                            CornerRadius="10"
                            Padding="14">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="StepInstallBadge"
                                    Width="28"
                                    Height="28"
                                    CornerRadius="14"
                                    Background="#1E293B">
                                <TextBlock Text="3"
                                           Foreground="#CBD5E1"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock x:Name="StepInstallTitle"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="Установка" />
                                <TextBlock x:Name="StepInstallSubtitle"
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           Text="Установка и завершение" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Foreground="#64748B"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="Данные приложения будут храниться отдельно." />
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="20">
            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="WelcomePage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Foreground="{StaticResource TextBrush}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Text="Установка AdbControl" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Text="Выбери папку установки и при необходимости создай ярлык на рабочем столе." />

                        <Border Grid.Row="2"
                                Margin="0,28,0,0"
                                Background="{StaticResource MutedSurfaceBrush}"
                                CornerRadius="12"
                                Padding="18">
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource TextBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="Что будет установлено" />
                                <TextBlock Margin="0,14,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="14"
                                           Text="• AdbControl" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="14"
                                           Text="• Ярлык в меню Пуск" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="14"
                                           Text="• Ярлык на рабочем столе, если ты его включишь" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="OptionsPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Foreground="{StaticResource TextBrush}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Text="Параметры установки" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Text="Папка установки и ярлык на рабочем столе." />

                        <TextBlock Grid.Row="2"
                                   Margin="0,28,0,8"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Text="Папка установки" />

                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="InstallPathTextBox"
                                     Style="{StaticResource FieldStyle}" />

                            <Button Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="BrowseInstallPath_Click"
                                    Content="Выбрать" />
                        </Grid>

                        <StackPanel Grid.Row="4"
                                    Margin="0,24,0,0">
                            <CheckBox x:Name="DesktopShortcutCheckBox"
                                      Foreground="{StaticResource TextBrush}"
                                      FontSize="14"
                                      Content="Создать ярлык на рабочем столе"
                                      IsChecked="True" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="InstallingPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Foreground="{StaticResource TextBrush}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Text="Идёт установка" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Text="Подождите, это может занять немного времени." />

                        <StackPanel Grid.Row="2"
                                    Margin="0,28,0,0">
                            <ProgressBar IsIndeterminate="True"
                                         Height="8"
                                         Foreground="{StaticResource AccentBrush}"
                                         Background="#E2E8F0" />
                            <TextBlock x:Name="InstallingStatusTextBlock"
                                       Margin="0,16,0,0"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="Подготовка установки..." />
                            <TextBlock x:Name="InstallingDetailsTextBlock"
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Text="Не закрывайте окно до завершения установки." />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="CompletedPage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="CompletedTitleTextBlock"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Text="Установка завершена" />
                        <TextBlock x:Name="CompletedSubtitleTextBlock"
                                   Grid.Row="1"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Text="AdbControl установлен и готов к запуску." />

                        <Border Grid.Row="2"
                                Margin="0,28,0,0"
                                Background="{StaticResource MutedSurfaceBrush}"
                                CornerRadius="12"
                                Padding="16">
                            <TextBlock x:Name="CompletedDetailsTextBlock"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="14"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="FooterStatusTextBlock"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="13"
                                   Text="" />

                        <Button x:Name="BackButton"
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BackButton_Click"
                                Content="Назад" />
                        <Button x:Name="ActionButton"
                                Grid.Column="2"
                                Margin="12,0,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ActionButton_Click"
                                Content="Далее" />
                        <Button x:Name="SecondaryActionButton"
                                Grid.Column="3"
                                Margin="12,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="SecondaryActionButton_Click"
                                Content="Закрыть" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
